rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTodoTask(data, userId) {
      return data.keys().hasAll([
               'userId',
               'title',
               'notes',
               'category',
               'priority',
               'completed',
               'dueDateMillis',
               'createdAt',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId',
               'title',
               'notes',
               'category',
               'priority',
               'completed',
               'dueDateMillis',
               'createdAt',
               'updatedAt'
             ]) &&
             data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 200 &&
             data.notes is string &&
             data.notes.size() <= 1000 &&
             data.category is string &&
             data.category in ['WORK', 'PERSONAL', 'SHOPPING', 'STUDY', 'HEALTH'] &&
             data.priority is string &&
             data.priority in ['LOW', 'MEDIUM', 'HIGH'] &&
             data.completed is bool &&
             data.dueDateMillis is int &&
             data.dueDateMillis >= 0 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(taskId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(taskId) &&
                       isValidTodoTask(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(taskId) &&
                       isValidTodoTask(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title',
                         'notes',
                         'category',
                         'priority',
                         'completed',
                         'dueDateMillis',
                         'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(taskId);
    }
  }
}
